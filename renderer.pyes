#from PIL import Image, ImageDraw
import time
import math
import random

WIDTH = 240
HEIGHT = 240
CENTER = WIDTH // 2

class JarvisRenderer:

    def __init__(self):
        self.blink = False
        self.next_blink = time.time() + random.uniform(3, 6)

    def smooth_color(self, t, emotion="idle"):
        if emotion == "idle":
            base = 180 + int((math.sin(t * 0.5) + 1) * 40)
            return (0, base, base)

        if emotion == "happy":
            return (255, 200, 0)

        if emotion == "thinking":
            return (180, 0, 255)

        if emotion == "listening":
            return (0, 150, 255)

        return (0, 200, 200)

    def draw_idle_eyes(self, draw, t, emotion="idle"):
        now = time.time()
        color = self.smooth_color(t, emotion)

        breath = (math.sin(t * 2) + 1) / 2
        eye_scale = 1 + breath * 0.05

        eye_width = int(40 * eye_scale)
        eye_height = int(50 * eye_scale)
        spacing = 35
        eye_y = CENTER

        # Blink logic
        if now > self.next_blink:
            self.blink = True
            self.next_blink = now + 0.15

        if self.blink and now > self.next_blink:
            self.blink = False
            self.next_blink = now + random.uniform(3, 6)

        if not self.blink:
            draw.rounded_rectangle(
                (
                    CENTER - spacing - eye_width,
                    eye_y - eye_height // 2,
                    CENTER - spacing,
                    eye_y + eye_height // 2
                ),
                radius=15,
                fill=color
            )

            draw.rounded_rectangle(
                (
                    CENTER + spacing,
                    eye_y - eye_height // 2,
                    CENTER + spacing + eye_width,
                    eye_y + eye_height // 2
                ),
                radius=15,
                fill=color
            )
        else:
            draw.line(
                (
                    CENTER - spacing - eye_width,
                    eye_y,
                    CENTER - spacing,
                    eye_y
                ),
                fill=color,
                width=4
            )

            draw.line(
                (
                    CENTER + spacing,
                    eye_y,
                    CENTER + spacing + eye_width,
                    eye_y
                ),
                fill=color,
                width=4
            )

    def render(self, emotion="idle", overlay=None):

    	t = time.time()
   	 image = Image.new("RGB", (WIDTH, HEIGHT), (0, 0, 0))
   	 draw = ImageDraw.Draw(image)

   	 # Base eyes (wallpaper)
   	 self.draw_idle_eyes(draw, t, emotion)

   	 # Overlay module
   	 if overlay:
       	 overlay(draw)

   	 return image
